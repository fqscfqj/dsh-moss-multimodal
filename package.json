{
  "name": "dsh-moss-multimodal",
  "version": "1.0.2",
  "type": "module",
  "description": "MOSS multimodal workbench for image, speech, voice, transcription and visual understanding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fqscfqj/dsh-moss-multimodal.git"
  },
  "homepage": "https://github.com/fqscfqj/dsh-moss-multimodal#readme",
  "bugs": {
    "url": "https://github.com/fqscfqj/dsh-moss-multimodal/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "moss",
    "multimodal",
    "image-generation",
    "speech"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check moss-api.js",
    "test": "node --test test/*.test.js"
  },
  "files": [
    "index.js",
    "client.js",
    "moss-api.js",
    "features.js",
    "assets.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
